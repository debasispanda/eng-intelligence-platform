DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/engineering_intelligence
# Keep this as public until the planned schema cutover. The platform target is platform.
DATABASE_SCHEMA=public
# Name of the unauthenticated development organization served by the dashboard.
DEFAULT_ORGANIZATION_NAME=Engineering Intelligence Demo
GITHUB_API_URL=https://api.github.com
# Required only when running GitHub synchronization.
GITHUB_TOKEN=
GITHUB_PAGE_SIZE=100
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
# Create an Atlassian API token for the dedicated read-only service account.
JIRA_API_TOKEN=
# Comma-separated project keys, for example PLATFORM,WEB.
JIRA_PROJECT_KEYS=
REDIS_URL=redis://localhost:6379/0
INGESTION_QUEUE_NAME=engineering-intelligence-ingestion
INGESTION_SCHEDULE_SECONDS=60
INGESTION_LOCK_SECONDS=7200
LLM_GATEWAY_URL=http://localhost:4000
LLM_API_KEY=sk-platform-dev
LLM_MODEL=engineering-summary
LLM_TIMEOUT_SECONDS=120
