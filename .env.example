# App Compose environment.
# These hostnames resolve on the external network created by the platform
# repository. Keep backend/.env for direct host-based development.
DATABASE_URL=postgresql+psycopg://postgres:password@postgres:5432/platform
DATABASE_SCHEMA=public
REDIS_URL=redis://redis:6379/0
PLATFORM_NETWORK_NAME=platform_default

BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_ORGANIZATION_NAME=Engineering Intelligence Demo
INGESTION_QUEUE_NAME=engineering-intelligence-ingestion
INGESTION_SCHEDULE_SECONDS=3600
INGESTION_LOCK_SECONDS=7200
LLM_GATEWAY_URL=http://litellm:4000
LLM_API_KEY=sk-platform-dev
LLM_MODEL=engineering-summary
LLM_TIMEOUT_SECONDS=120

GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_PAGE_SIZE=100
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=
